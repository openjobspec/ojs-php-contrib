{
    "name": "openjobspec/laravel",
    "description": "Laravel integration for Open Job Spec (OJS)",
    "type": "library",
    "license": "Apache-2.0",
    "keywords": ["laravel", "background-jobs", "job-queue", "openjobspec", "ojs"],
    "homepage": "https://openjobspec.org",
    "authors": [
        {
            "name": "OpenJobSpec Contributors"
        }
    ],
    "support": {
        "issues": "https://github.com/openjobspec/ojs-php-contrib/issues",
        "source": "https://github.com/openjobspec/ojs-php-contrib/tree/main/ojs-laravel"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../.deps/ojs-php-sdk",
            "options": {
                "symlink": false,
                "versions": {
                    "openjobspec/sdk": "0.5.0"
                }
            }
        }
    ],
    "require": {
        "php": ">=8.2",
        "openjobspec/sdk": "^0.5",
        "illuminate/console": "^12.0",
        "illuminate/contracts": "^12.0",
        "illuminate/queue": "^12.0",
        "illuminate/support": "^12.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "orchestra/testbench": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "OpenJobSpec\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OpenJobSpec\\Laravel\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always"
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenJobSpec\\Laravel\\OjsServiceProvider"
            ],
            "aliases": {
                "Ojs": "OpenJobSpec\\Laravel\\Facades\\Ojs"
            }
        }
    },
    "config": {
        "allow-plugins": {},
        "sort-packages": true
    }
}
