{
    "name": "openjobspec/symfony",
    "description": "Symfony integration for Open Job Spec (OJS)",
    "type": "symfony-bundle",
    "license": "Apache-2.0",
    "keywords": ["symfony", "background-jobs", "job-queue", "openjobspec", "ojs"],
    "homepage": "https://openjobspec.org",
    "authors": [
        {
            "name": "OpenJobSpec Contributors"
        }
    ],
    "support": {
        "issues": "https://github.com/openjobspec/ojs-php-contrib/issues",
        "source": "https://github.com/openjobspec/ojs-php-contrib/tree/main/ojs-symfony"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../.deps/ojs-php-sdk",
            "options": {
                "symlink": false,
                "versions": {
                    "openjobspec/sdk": "0.5.0"
                }
            }
        }
    ],
    "require": {
        "php": ">=8.2",
        "openjobspec/sdk": "^0.5",
        "symfony/framework-bundle": "^7.0",
        "symfony/console": "^7.0",
        "symfony/dependency-injection": "^7.0",
        "symfony/event-dispatcher-contracts": "^3.0",
        "symfony/messenger": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "OpenJobSpec\\Symfony\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OpenJobSpec\\Symfony\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always"
    },
    "config": {
        "allow-plugins": {},
        "sort-packages": true
    }
}
